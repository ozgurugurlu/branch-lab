# No API key is needed for the deterministic demo.
# Optional Neon/PostgreSQL; takes precedence over TURSO_DATABASE_URL when set.
# Use your Neon pooled URL, including sslmode=require&channel_binding=require.
DATABASE_URL=
# PostgreSQL tables stay in this dedicated schema; no public-schema fallback.
# Existing compatible Branchlab installations in public can explicitly set public.
DATABASE_SCHEMA=branchlab
# Optional PEM certificate authority for a private PostgreSQL server.
DATABASE_SSL_CA=
# Local persistence (automatically created):
TURSO_DATABASE_URL=file:.data/branchlab.db
# Vercel: replace the URL with libsql://your-database.turso.io and supply a token.
TURSO_AUTH_TOKEN=

# Instance access password. REQUIRED to enable live models on hosted deployments.
# Setting a password also protects demo workspaces on that instance.
APP_PASSWORD=
# When set, only this exact browser origin may mutate data.
APP_ORIGIN=
# Global model-request reservations per fixed 24-hour window.
# Up to three model steps are reserved per agent; SDK retries are disabled.
DAILY_MODEL_CALL_LIMIT=1000

OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
# Aliases GEMINI_API_KEY and GOOGLE_API_KEY are also accepted.

# Optional real web search. Still requires explicit per-scenario consent.
BRAVE_SEARCH_API_KEY=

# Enable explicitly after starting your local model server.
ENABLE_LOCAL_MODELS=false
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_API_KEY=
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
LMSTUDIO_API_KEY=

# Optional: disable Next.js telemetry.
NEXT_TELEMETRY_DISABLED=1
