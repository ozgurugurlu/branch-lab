# No API key is needed for the deterministic demo.
# Local persistence (automatically created):
TURSO_DATABASE_URL=file:.data/branchlab.db
# Vercel: replace the URL with libsql://your-database.turso.io and supply a token.
TURSO_AUTH_TOKEN=

# Instance access password. REQUIRED to enable live models on hosted deployments.
# Setting a password also protects demo workspaces on that instance.
APP_PASSWORD=
# Optional canonical origin when behind a reverse proxy, e.g. https://lab.example.com
APP_ORIGIN=
# Global logical model-call reservations per fixed 24-hour window.
# Retries within an individual logical call can still consume additional provider usage.
DAILY_MODEL_CALL_LIMIT=1000

OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
# Aliases GEMINI_API_KEY and GOOGLE_API_KEY are also accepted.

# Enable explicitly after starting your local model server.
ENABLE_LOCAL_MODELS=false
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_API_KEY=
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
LMSTUDIO_API_KEY=

# Optional: disable Next.js telemetry.
NEXT_TELEMETRY_DISABLED=1
